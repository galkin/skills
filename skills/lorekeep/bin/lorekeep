#!/bin/sh
# Generated by `lorekeep skill --build`: runs lorekeep 0.2.0 from its release tag.
# uv builds it once per machine into its cache; every checkout that vendors this skill
# shares that environment, and nothing is installed into the repository.
exec uvx --quiet --from "git+https://github.com/galkin/skills@lorekeep-v0.2.0#subdirectory=lorekeep" lorekeep "$@"

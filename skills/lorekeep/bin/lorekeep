#!/bin/sh
# Generated by `lorekeep skill --build`: runs lorekeep 0.2.1 (lorekeep-v0.2.1) with its browser extra.
# uv builds it once per machine into its cache; every checkout that vendors this skill
# shares that environment, and nothing is installed into the repository. Chromium is
# not part of it: `lorekeep status` says when it is missing and how to install it.
